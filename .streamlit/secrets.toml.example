# Copy these placeholders into the deployment secret manager. Never commit
# .streamlit/secrets.toml. The redirect URI must exactly match the app URL.
[auth]
redirect_uri = "https://replace-with-pilot-host.example/oauth2callback"
cookie_secret = "replace-with-a-random-secret"
client_id = "replace-with-oidc-client-id"
client_secret = "replace-with-oidc-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
